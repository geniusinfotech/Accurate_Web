# Public URL of the API, including /api. Baked in at build time (NEXT_PUBLIC_*),
# so set it BEFORE `npm run build`. If it is missing the site silently calls localhost.
NEXT_PUBLIC_API_URL=https://sit.accurateliquid.com/api
# Public site URL used for canonical links, sitemap and WhatsApp/social previews.
NEXT_PUBLIC_SITE_URL=https://accurateliquid.com
# Optional, server-only. Internal address of the API for server-side fetches (product page titles, sitemap).
# Set it if the web host cannot reach its own public API hostname; without it those fetches time out.
# Use 127.0.0.1, not localhost: Node can resolve localhost to IPv6 (::1) and stall.
# API_INTERNAL_URL=http://127.0.0.1:9010
